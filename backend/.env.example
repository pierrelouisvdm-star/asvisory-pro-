# --- Database ---------------------------------------------------------
# MongoDB connection string. For local dev, run Mongo in Docker
# (see docker-compose.yml) or use a free MongoDB Atlas cluster.
MONGO_URL=mongodb://localhost:27017
DB_NAME=advisorypro

# --- Auth ---------------------------------------------------------------
# Any long random string. Generate one with: openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string

# --- AI (OpenAI) ---------------------------------------------------------
# Used for: receipt OCR (GPT-4o Vision), voice transaction parsing
# (Whisper + GPT-4o), and the AI Advisor chat. Get a key at
# https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...
DEFAULT_LLM_MODEL=gpt-4o

# --- Payments: Stripe (US) ------------------------------------------------
# https://dashboard.stripe.com/apikeys
STRIPE_API_KEY=sk_test_...
# Set this after creating a webhook endpoint in the Stripe dashboard
# pointing at https://<your-domain>/api/webhook/stripe
STRIPE_WEBHOOK_SECRET=whsec_...

# --- Payments: PayFast (South Africa) -------------------------------------
PAYFAST_MERCHANT_ID=
PAYFAST_MERCHANT_KEY=
PAYFAST_PASSPHRASE=

# --- Email (password reset) -----------------------------------------------
# https://resend.com/api-keys
RESEND_API_KEY=re_...
SENDER_EMAIL=noreply@yourdomain.com
ADMIN_EMAIL=you@yourdomain.com

# --- File storage -----------------------------------------------------------
# Receipts are stored on local disk by default. Point this at a mounted
# volume in production (or swap to S3/R2 in routes/transactions.py).
UPLOAD_DIR=./uploads

# --- Misc -------------------------------------------------------------------
# Comma-separated list, no trailing slashes. In production, set this to your
# real frontend origin(s), e.g. https://advisorypro.co.za,https://www.advisorypro.co.za
CORS_ORIGINS=http://localhost:3000
